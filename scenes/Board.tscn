[sub_resource type="Shader" id="Shader_hs2ul"]
code = "shader_type canvas_item;

uniform float intensity : hint_range(0.0, 1.0) = 0.0;
uniform float speed : hint_range(0.0, 50.0) = 10.0;

void fragment() {
    // Calculate shake offset using built-in TIME
    vec2 shake_offset = vec2(
        sin(TIME * speed) * intensity,
        cos(TIME * speed * 0.7) * intensity
    ) * 10.0;

    // Apply the shake to UV coordinates
    COLOR = texture(TEXTURE, UV + shake_offset);
}"

