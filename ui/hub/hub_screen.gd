extends Control

# Shared base for the hub-style screens (hub, leaderboards, community
# playlists): paper background, the top bar (logo, Play / Playlists /
# Leaderboards / Profile tabs, online count, icon buttons, profile chip), the
# settings modal, toasts and small widget builders.
#
# Screens extend this by path and call _setup_screen("<active tab>") in
# _ready; it returns the column to put the page body in.
#
# Every colour, font, radius and border comes from ui/hub/hub_theme.tres
# (generated by tools/make_hub_theme.gd). Scripts only read extra colours via
# get_theme_color(name, "Hub").

const HUB_THEME := preload("res://ui/hub/hub_theme.tres")
const HUB_SCENE := "res://ui/hub/hub.tscn"
const LEADERBOARD_SCENE := "res://scenes/LeaderboardScreen.tscn"
const PLAYLISTS_SCENE := "res://scenes/PlaylistsScreen.tscn"
const PROFILE_SCENE := "res://scenes/ProfileScreen.tscn"
const SETTINGS_PATH := "user://scene_data.tres"
const ICON_DIR := "res://ui/icons/"
const LOGO := "res://ui/hub/cite_logo_ink.png"
const CLICK_FOLDER := "res://assets/sounds/sfx/click"

const TOP_BAR_HEIGHT := 52
const RIGHT_COLUMN_WIDTH := 292
const TOAST_SECONDS := 2.2
const PLAYER_COUNT_REFRESH_SECONDS := 60.0
const NOTIFICATIONS_WIDTH := 320

# Notifications (dummy for now - there's no backend). Read/dismissed ids and
# when each was first seen are kept in HUB_STATE_PATH. Delete that file to
# see them again.
const HUB_STATE_PATH := "user://hub_state.cfg"
const NOTIFICATIONS := [
	{"id": "welcome", "icon": "sparkles", "title": "Welcome to Cite!",
		"body": "Guess Wikipedia articles from censored text. Start a run, or challenge a friend to a Private Match."},
]

var settings: SaveData
var toast: Label
var toast_tween: Tween
var modal_layer: Control
var active_tab := ""
# steam_id -> TextureRects waiting for / showing that player's Steam avatar.
var avatar_targets := {}
var online_row: Control
var bell_button: Button
var bell_badge: Label
var notifications_layer: Control
var online_label: Label


# Builds background, margins, top bar, toast and modal layer. Returns the
# column under the top bar; add the page body to it (expand it vertically).
func _setup_screen(tab: String, show_top_bar := true) -> VBoxContainer:
	active_tab = tab
	theme = HUB_THEME
	settings = ResourceLoader.load(SETTINGS_PATH) as SaveData
	if not settings:
		settings = SaveData.new()

	set_anchors_preset(Control.PRESET_FULL_RECT)
	texture_filter = CanvasItem.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS
	Steam.avatar_image_loaded.connect(_on_avatar_image_loaded)

	var bg := ColorRect.new()
	bg.color = get_theme_color("bg", "Hub")
	bg.set_anchors_preset(Control.PRESET_FULL_RECT)
	bg.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(bg)

	var root := MarginContainer.new()
	root.set_anchors_preset(Control.PRESET_FULL_RECT)
	for side in ["left", "right"]:
		root.add_theme_constant_override("margin_" + side, 20)
	root.add_theme_constant_override("margin_top", 12)
	root.add_theme_constant_override("margin_bottom", 18)
	add_child(root)

	var column := VBoxContainer.new()
	column.add_theme_constant_override("separation", 14)
	root.add_child(column)
	if show_top_bar:
		column.add_child(_build_top_bar())

	toast = Label.new()
	toast.theme_type_variation = "TagLabel"
	toast.add_theme_font_size_override("font_size", 13)
	toast.set_anchors_preset(Control.PRESET_CENTER_BOTTOM)
	toast.grow_horizontal = Control.GROW_DIRECTION_BOTH
	toast.position.y -= 46
	toast.modulate.a = 0.0
	toast.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(toast)

	modal_layer = Control.new()
	modal_layer.set_anchors_preset(Control.PRESET_FULL_RECT)
	modal_layer.mouse_filter = Control.MOUSE_FILTER_IGNORE
	add_child(modal_layer)
	return column


# --- Top bar ----------------------------------------------------------------

func _build_top_bar() -> Control:
	var bar := HBoxContainer.new()
	bar.custom_minimum_size.y = TOP_BAR_HEIGHT
	bar.add_theme_constant_override("separation", 14)

	var logo := TextureRect.new()
	logo.texture = load(LOGO)
	logo.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	logo.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	logo.custom_minimum_size = Vector2(86, 34)
	logo.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	bar.add_child(logo)

	var nav := HBoxContainer.new()
	nav.add_theme_constant_override("separation", 2)
	var group := ButtonGroup.new()
	for entry in [["Play", _on_nav_play], ["Playlists", _on_nav_playlists],
			["Leaderboards", _on_nav_leaderboards], ["Profile", _on_nav_profile]]:
		var tab := Button.new()
		tab.text = entry[0]
		tab.theme_type_variation = "NavTab"
		tab.toggle_mode = true
		tab.button_group = group
		tab.button_pressed = entry[0] == active_tab
		tab.focus_mode = Control.FOCUS_NONE
		tab.size_flags_vertical = Control.SIZE_SHRINK_CENTER
		var target: Callable = entry[1]
		var tab_name: String = entry[0]
		tab.pressed.connect(func():
			if tab_name != active_tab:
				SoundManagerScript.play_random_sound_from_folder_with_pitch(CLICK_FOLDER, "UI")
				target.call())
		nav.add_child(tab)
	bar.add_child(nav)

	var spacer := Control.new()
	spacer.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	bar.add_child(spacer)

	# Live count of everyone running Cite (Steam), refreshed every minute.
	online_row = HBoxContainer.new()
	online_row.add_theme_constant_override("separation", 8)
	online_row.add_child(_status_dot("online"))
	online_label = _label("", "SmallLabel")
	online_label.add_theme_font_size_override("font_size", 13)
	online_row.add_child(online_label)
	online_row.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	online_row.visible = false
	bar.add_child(online_row)
	Steam.number_of_current_players.connect(_on_player_count)
	var count_timer := Timer.new()
	count_timer.wait_time = PLAYER_COUNT_REFRESH_SECONDS
	count_timer.timeout.connect(_request_player_count)
	add_child(count_timer)
	count_timer.start()
	_request_player_count()

	bell_button = _icon_button("bell", "Notifications", _toggle_notifications, "0")
	bell_badge = bell_button.get_child(0)
	bar.add_child(bell_button)
	_update_bell_badge()
	bar.add_child(_icon_button("settings", "Settings", _open_settings))
	bar.add_child(_profile_chip())
	return bar


func _profile_chip() -> Control:
	var chip := PanelContainer.new()
	chip.theme_type_variation = "ProfileChip"
	chip.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)
	chip.add_child(row)
	var own_name := Global.get_own_name()
	row.add_child(_avatar(own_name, 32, Steam.getSteamID() if Steam.loggedOn() else 0))
	var who := VBoxContainer.new()
	who.add_theme_constant_override("separation", 0)
	who.alignment = BoxContainer.ALIGNMENT_CENTER
	var name_label := _label(own_name, "NameLabel")
	name_label.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	name_label.custom_minimum_size.x = 110
	who.add_child(name_label)
	var rating := _label("", "SmallMuted")
	rating.add_theme_font_size_override("font_size", 11)
	who.add_child(rating)
	_watch_rating(rating, "Rating %s")
	row.add_child(who)
	return chip


func _request_player_count() -> void:
	if Steam.loggedOn():
		Steam.getNumberOfCurrentPlayers()


func _on_player_count(success: int, players: int) -> void:
	if success != 1:
		return
	# Steam can leave out this very player (e.g. running from the editor) -
	# whoever is looking at the screen is playing.
	players = maxi(players, 1)
	online_label.text = "%s playing now" % _thousands(players)
	online_row.visible = true


# Labels showing the Ranked rating (format has one %s for the number, "" =
# the status line instead: placement progress or W/L); they update when
# Ratings loads the Steam copy or a match changes it.
var rating_labels := {}  # Label -> format


func _watch_rating(label: Label, format: String) -> void:
	rating_labels[label] = format
	if not Ratings.changed.is_connected(_refresh_ratings):
		Ratings.changed.connect(_refresh_ratings)
	_refresh_ratings()


func _refresh_ratings() -> void:
	for label in rating_labels.keys():
		if is_instance_valid(label):
			var format: String = rating_labels[label]
			label.text = Ratings.status_text() if format.is_empty() else format % _thousands(Ratings.rating)
		else:
			rating_labels.erase(label)


static func _thousands(n: int) -> String:
	var s := str(n)
	var out := ""
	while s.length() > 3:
		out = "," + s.substr(s.length() - 3) + out
		s = s.substr(0, s.length() - 3)
	return s + out


# --- Notifications --------------------------------------------------------------

func _hub_state() -> ConfigFile:
	var cfg := ConfigFile.new()
	cfg.load(HUB_STATE_PATH)  # missing file = empty state
	return cfg


# Notifications the player hasn't dismissed, each with "unread" and "seen_at".
func _notifications() -> Array:
	var cfg := _hub_state()
	var dismissed: Array = cfg.get_value("notifications", "dismissed", [])
	var read: Array = cfg.get_value("notifications", "read", [])
	var seen: Dictionary = cfg.get_value("notifications", "seen_at", {})
	var now := int(Time.get_unix_time_from_system())
	var changed := false
	var out := []
	for n in NOTIFICATIONS:
		if n["id"] in dismissed:
			continue
		if not seen.has(n["id"]):
			seen[n["id"]] = now
			changed = true
		var item: Dictionary = n.duplicate()
		item["unread"] = not (n["id"] in read)
		item["seen_at"] = seen[n["id"]]
		out.append(item)
	if changed:
		cfg.set_value("notifications", "seen_at", seen)
		cfg.save(HUB_STATE_PATH)
	return out


func _mark_notifications(key: String, ids: Array) -> void:
	var cfg := _hub_state()
	var list: Array = cfg.get_value("notifications", key, [])
	for id in ids:
		if not id in list:
			list.append(id)
	cfg.set_value("notifications", key, list)
	cfg.save(HUB_STATE_PATH)


# The number on the bell = unread notifications; hidden at 0.
func _update_bell_badge() -> void:
	var unread := 0
	for n in _notifications():
		if n["unread"]:
			unread += 1
	bell_badge.text = str(unread)
	bell_badge.visible = unread > 0


func _toggle_notifications() -> void:
	if notifications_layer:
		_close_notifications()
	else:
		_open_notifications()


func _open_notifications() -> void:
	var items := _notifications()
	# Opening the list counts as reading everything in it.
	_mark_notifications("read", items.map(func(n): return n["id"]))
	_update_bell_badge()

	# Full-screen catcher: clicking anywhere outside closes the dropdown.
	notifications_layer = Control.new()
	notifications_layer.set_anchors_preset(Control.PRESET_FULL_RECT)
	notifications_layer.mouse_filter = Control.MOUSE_FILTER_STOP
	notifications_layer.gui_input.connect(func(event: InputEvent):
		if event is InputEventMouseButton and event.pressed:
			_close_notifications())
	modal_layer.add_child(notifications_layer)

	var panel := PanelContainer.new()
	panel.theme_type_variation = "DropdownPanel"
	panel.custom_minimum_size.x = NOTIFICATIONS_WIDTH
	notifications_layer.add_child(panel)
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 6)
	panel.add_child(box)
	var head := _label("Notifications", "HeaderSmall")
	box.add_child(head)
	box.add_child(HSeparator.new())

	if items.is_empty():
		var empty := _label("You're all caught up.", "MutedLabel")
		empty.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		empty.custom_minimum_size.y = 48
		empty.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
		box.add_child(empty)
	for n in items:
		box.add_child(_notification_row(n))

	# Hang it under the bell, right edges lined up.
	var bell_rect := bell_button.get_global_rect()
	var global_to_local := get_global_transform().affine_inverse()
	var corner := global_to_local * Vector2(bell_rect.end.x, bell_rect.end.y + 8)
	panel.reset_size()
	panel.position = Vector2(clampf(corner.x - NOTIFICATIONS_WIDTH, 8, size.x - NOTIFICATIONS_WIDTH - 8), corner.y)


func _notification_row(n: Dictionary) -> Control:
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 10)

	var icon_box := PanelContainer.new()
	icon_box.theme_type_variation = "ModeIcon"
	icon_box.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	var icon := _icon(n["icon"], 18)
	icon.modulate = get_theme_color("accent", "Hub")
	icon_box.add_child(icon)
	row.add_child(icon_box)

	var text := VBoxContainer.new()
	text.add_theme_constant_override("separation", 2)
	text.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	var title_row := HBoxContainer.new()
	title_row.add_theme_constant_override("separation", 6)
	var title := _label(n["title"], "NameLabel")
	title.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	title_row.add_child(title)
	title_row.add_child(_label(_time_ago(n["seen_at"]), "SmallMuted"))
	text.add_child(title_row)
	var body := _label(n["body"], "SmallMuted")
	body.autowrap_mode = TextServer.AUTOWRAP_WORD_SMART
	body.custom_minimum_size.x = 180
	text.add_child(body)
	row.add_child(text)

	var id: String = n["id"]
	var dismiss := _button("", "RowIconButton", func():
		_mark_notifications("dismissed", [id])
		_update_bell_badge()
		_close_notifications()
		_open_notifications())
	dismiss.icon = load(ICON_DIR + "x.svg")
	dismiss.expand_icon = true
	dismiss.custom_minimum_size = Vector2(26, 26)
	dismiss.tooltip_text = "Dismiss"
	dismiss.size_flags_vertical = Control.SIZE_SHRINK_BEGIN
	row.add_child(dismiss)
	return row


static func _time_ago(unix: int) -> String:
	var secs := int(Time.get_unix_time_from_system()) - unix
	if secs < 60:
		return "just now"
	if secs < 3600:
		return "%dm ago" % (secs / 60)
	if secs < 86400:
		return "%dh ago" % (secs / 3600)
	return "%dd ago" % (secs / 86400)


func _close_notifications() -> void:
	if notifications_layer:
		notifications_layer.queue_free()
		notifications_layer = null


# Esc closes the notifications dropdown before anything else (this runs
# before Global's Esc-presses-Back handler).
func _input(event: InputEvent) -> void:
	if notifications_layer and event is InputEventKey and event.pressed \
			and not event.is_echo() and event.keycode == KEY_ESCAPE:
		get_viewport().set_input_as_handled()
		_close_notifications()


# --- Navigation -------------------------------------------------------------

func _on_nav_play() -> void:
	get_tree().change_scene_to_file(HUB_SCENE)


func _on_nav_playlists() -> void:
	get_tree().change_scene_to_file(PLAYLISTS_SCENE)


func _on_nav_leaderboards() -> void:
	get_tree().change_scene_to_file(LEADERBOARD_SCENE)


func _on_nav_profile() -> void:
	get_tree().change_scene_to_file(PROFILE_SCENE)


# Opens the lobby's host form with this playlist already picked.
func _create_room_with(playlist_id: String) -> void:
	Global.multiplayer_playlist_id = playlist_id
	_open_lobby("host")


func _open_lobby(entry: String) -> void:
	Global.multiplayer_lobby_entry = entry
	Global.lobby_return_scene = "" if scene_file_path == Global.MENU_SCENE else scene_file_path
	get_tree().change_scene_to_file("res://scenes/MultiplayerLobby.tscn")


# Starts Single Player Normal (playlist id, or null for every official one)
# or Hardcore - same as Main's Normal/Hardcore, never Legacy.
func _start_single_player(hardcore: bool, playlist) -> void:
	Global.selected_categories = []
	Global.selected_playsets = [] if playlist == null else [playlist]
	if not hardcore:
		SoundManagerScript.play_music_direct("res://assets/sounds/music/music.mp3")
	Global.start_new_run()
	Global.legacy_mode = false
	if hardcore:
		Global.run.current_game_mode = Global.run.GameMode.HARDCORE
	else:
		Global.run.current_game_mode = Global.run.GameMode.NORMAL
	get_tree().change_scene_to_file("res://scenes/Round.tscn")


# --- Small builders -----------------------------------------------------------

func _label(text: String, variation := "") -> Label:
	var l := Label.new()
	l.text = text
	if not variation.is_empty():
		l.theme_type_variation = variation
	return l


func _button(text: String, variation: String, on_pressed: Callable) -> Button:
	var b := Button.new()
	b.text = text
	if not variation.is_empty():
		b.theme_type_variation = variation
	b.focus_mode = Control.FOCUS_NONE
	b.pressed.connect(func():
		SoundManagerScript.play_random_sound_from_folder_with_pitch(CLICK_FOLDER, "SFX")
		on_pressed.call())
	return b


func _spacer(expand_vertical := false, min_size := 0) -> Control:
	var c := Control.new()
	if expand_vertical:
		c.size_flags_vertical = Control.SIZE_EXPAND_FILL
		c.custom_minimum_size.y = min_size
	else:
		c.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		c.custom_minimum_size.x = min_size
	c.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return c


func _icon(icon_name: String, px: int) -> TextureRect:
	var r := TextureRect.new()
	r.texture = load(ICON_DIR + icon_name + ".svg")
	r.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
	r.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_CENTERED
	r.custom_minimum_size = Vector2(px, px)
	r.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return r


func _icon_button(icon_name: String, tip: String, on_pressed: Callable, badge := "") -> Button:
	var b := _button("", "IconButton", on_pressed)
	b.icon = load(ICON_DIR + icon_name + ".svg")
	b.expand_icon = true
	b.icon_alignment = HORIZONTAL_ALIGNMENT_CENTER
	b.custom_minimum_size = Vector2(38, 38)
	b.tooltip_text = tip
	b.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	if not badge.is_empty():
		var l := _label(badge, "BadgeLabel")
		l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
		l.position = Vector2(26, -7)
		l.custom_minimum_size = Vector2(18, 0)
		b.add_child(l)
	return b


# Round avatar: the first letter on an ink tile, with the player's Steam
# avatar laid over it (clipped to the circle) once Steam has it.
func _avatar(who: String, px: int, steam_id := 0) -> Control:
	var tile := PanelContainer.new()
	tile.theme_type_variation = "Avatar"
	tile.custom_minimum_size = Vector2(px, px)
	tile.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	tile.mouse_filter = Control.MOUSE_FILTER_IGNORE
	var l := _label(who.substr(0, 1).to_upper(), "NameLabel")
	l.add_theme_color_override("font_color", get_theme_color("bg", "Hub"))
	l.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	l.vertical_alignment = VERTICAL_ALIGNMENT_CENTER
	tile.add_child(l)
	if steam_id != 0:
		tile.clip_children = CanvasItem.CLIP_CHILDREN_AND_DRAW
		var img := TextureRect.new()
		img.expand_mode = TextureRect.EXPAND_IGNORE_SIZE
		img.stretch_mode = TextureRect.STRETCH_KEEP_ASPECT_COVERED
		img.mouse_filter = Control.MOUSE_FILTER_IGNORE
		tile.add_child(img)
		if not avatar_targets.has(steam_id):
			avatar_targets[steam_id] = []
		avatar_targets[steam_id].append(img)
		_refresh_avatar(steam_id)
	return tile


# Asks Steam for the avatar again (e.g. after persona info arrived).
func _refresh_avatar(steam_id: int) -> void:
	if not Steam.loggedOn() or not avatar_targets.has(steam_id):
		return
	# 0 = no avatar set, -1 = still loading (avatar_image_loaded follows).
	var handle := Steam.getMediumFriendAvatar(steam_id)
	if handle > 0:
		_apply_avatar(steam_id, handle)


func _on_avatar_image_loaded(steam_id: int, image_handle: int, _width: int, _height: int) -> void:
	_apply_avatar(steam_id, image_handle)


func _apply_avatar(steam_id: int, handle: int) -> void:
	if not avatar_targets.has(steam_id):
		return
	var size_data := Steam.getImageSize(handle)
	var buffer_data := Steam.getImageRGBA(handle)
	if not size_data.get("success", false) or not buffer_data.get("success", false):
		return
	var width := int(size_data["width"])
	var height := int(size_data["height"])
	if width <= 0 or height <= 0:
		return
	var image := Image.create_from_data(width, height, false, Image.FORMAT_RGBA8, buffer_data["buffer"])
	var texture := ImageTexture.create_from_image(image)
	var alive := []
	for img in avatar_targets[steam_id]:
		if is_instance_valid(img):
			img.texture = texture
			alive.append(img)
	avatar_targets[steam_id] = alive


func _status_dot(state: String, px := 8) -> Control:
	var dot := Panel.new()
	var sb := StyleBoxFlat.new()
	sb.bg_color = get_theme_color(state, "Hub")
	sb.set_corner_radius_all(px)
	if px > 8:
		sb.set_border_width_all(2)
		sb.border_color = get_theme_color("surface", "Hub")
	dot.add_theme_stylebox_override("panel", sb)
	dot.custom_minimum_size = Vector2(px, px)
	dot.size = Vector2(px, px)
	dot.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	dot.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return dot


func _progress(value: float, min_size: Vector2) -> ProgressBar:
	var p := ProgressBar.new()
	p.theme_type_variation = "HubProgress"
	p.show_percentage = false
	p.value = value
	p.custom_minimum_size = min_size
	p.size_flags_horizontal = Control.SIZE_SHRINK_BEGIN
	p.mouse_filter = Control.MOUSE_FILTER_IGNORE
	return p


# Panel with a serif heading and a small muted note on the right. Returns the
# content VBox (its parent is the panel).
func _side_panel(title: String, note := "", variation := "SidePanel") -> VBoxContainer:
	var panel := PanelContainer.new()
	panel.theme_type_variation = variation
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 4)
	panel.add_child(box)
	var head := HBoxContainer.new()
	var h := _label(title, "HeaderSmall")
	h.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	head.add_child(h)
	if not note.is_empty():
		var n := _label(note, "SmallMuted")
		n.size_flags_vertical = Control.SIZE_SHRINK_END
		head.add_child(n)
	box.add_child(head)
	var gap := Control.new()
	gap.custom_minimum_size.y = 4
	box.add_child(gap)
	return box


# Segmented toggle (e.g. Normal | Hardcore). on_select gets the index.
# disabled: indices shown but not clickable (tooltip "Coming soon").
func _segmented(options: Array, selected: int, on_select: Callable, disabled := []) -> Control:
	var bar := PanelContainer.new()
	bar.theme_type_variation = "SegBar"
	bar.size_flags_vertical = Control.SIZE_SHRINK_CENTER
	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 2)
	bar.add_child(row)
	var group := ButtonGroup.new()
	for i in options.size():
		var b := Button.new()
		b.text = options[i]
		b.theme_type_variation = "SegButton"
		b.toggle_mode = true
		b.button_group = group
		b.button_pressed = i == selected
		b.focus_mode = Control.FOCUS_NONE
		if i in disabled:
			b.disabled = true
			b.tooltip_text = "Coming soon"
		var index: int = i
		b.pressed.connect(func():
			SoundManagerScript.play_random_click("SFX")
			on_select.call(index))
		row.add_child(b)
	return bar


func _show_toast(text: String) -> void:
	toast.text = text
	toast.reset_size()
	toast.position.x = (size.x - toast.size.x) * 0.5
	if toast_tween:
		toast_tween.kill()
	toast.modulate.a = 1.0
	toast_tween = create_tween()
	toast_tween.tween_interval(TOAST_SECONDS)
	toast_tween.tween_property(toast, "modulate:a", 0.0, 0.3)


# --- Modals -------------------------------------------------------------------

# A centred modal over the dimmed screen. Returns the content VBox. Close
# buttons join the "back_button" group so Esc closes the modal (Global._input).
func _open_modal(title: String, width: int) -> VBoxContainer:
	_close_modal()
	var dim := PanelContainer.new()
	dim.theme_type_variation = "OverlayDim"
	dim.set_anchors_preset(Control.PRESET_FULL_RECT)
	dim.mouse_filter = Control.MOUSE_FILTER_STOP
	modal_layer.add_child(dim)
	var center := CenterContainer.new()
	dim.add_child(center)
	var panel := PanelContainer.new()
	panel.theme_type_variation = "ModalPanel"
	panel.custom_minimum_size.x = width
	center.add_child(panel)
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 12)
	panel.add_child(box)
	var head := _label(title, "HeaderMedium")
	head.horizontal_alignment = HORIZONTAL_ALIGNMENT_CENTER
	box.add_child(head)
	return box


func _add_modal_close(box: VBoxContainer, text := "Close") -> void:
	var close := _button(text, "GhostButton", _close_modal)
	close.add_to_group("back_button")
	box.add_child(close)


func _close_modal() -> void:
	notifications_layer = null
	for c in modal_layer.get_children():
		c.queue_free()


func _modal_open() -> bool:
	return modal_layer.get_child_count() > 0


func _open_settings() -> void:
	var box := _open_modal("Settings", 380)
	var fullscreen := CheckBox.new()
	fullscreen.text = "Fullscreen"
	fullscreen.focus_mode = Control.FOCUS_NONE
	fullscreen.button_pressed = get_window().mode == Window.MODE_FULLSCREEN
	fullscreen.toggled.connect(_on_fullscreen_toggled)
	box.add_child(fullscreen)
	box.add_child(_volume_slider("Master volume", SoundManagerScript.master_volume, func(v):
		SoundManagerScript.set_master_volume(v)
		settings.master_volume = v))
	box.add_child(_volume_slider("Sound effects", SoundManagerScript.sfx_volume, func(v):
		SoundManagerScript.set_sfx_volume(v)
		settings.sfx_volume = v))
	box.add_child(_volume_slider("Music", SoundManagerScript.music_volume, func(v):
		SoundManagerScript.set_music_volume(v)
		settings.music_volume = v))
	# Same option as the in-match settings (Daily and matches use it).
	var auto_scroll := CheckBox.new()
	auto_scroll.text = "Scroll to revealed sentences"
	auto_scroll.focus_mode = Control.FOCUS_NONE
	auto_scroll.button_pressed = Global.auto_scroll_to_reveal
	auto_scroll.toggled.connect(func(on: bool):
		Global.auto_scroll_to_reveal = on
		settings.auto_scroll_to_reveal = on
		_save_settings())
	box.add_child(auto_scroll)
	box.add_child(HSeparator.new())

	var row := HBoxContainer.new()
	row.add_theme_constant_override("separation", 8)
	for entry in [["Tutorial", "res://scenes/Tutorial.tscn"], ["Credits", "res://scenes/Credits.tscn"]]:
		var path: String = entry[1]
		var b := _button(entry[0], "SmallButton", func(): get_tree().change_scene_to_file(path))
		b.size_flags_horizontal = Control.SIZE_EXPAND_FILL
		row.add_child(b)
	var quit := _button("Quit Game", "SmallButton", func(): get_tree().quit())
	quit.size_flags_horizontal = Control.SIZE_EXPAND_FILL
	row.add_child(quit)
	box.add_child(row)

	# Developer tools (were in the old menu's settings).
	var dev := HBoxContainer.new()
	dev.add_theme_constant_override("separation", 4)
	dev.alignment = BoxContainer.ALIGNMENT_CENTER
	dev.add_child(_label("Dev:", "SmallMuted"))
	for entry in [["Dummy Ranked", func(): _dev_dummy_matchmaking("Ranked")],
			["Dummy Quick Play", func(): _dev_dummy_matchmaking("Quick Play")],
			["Test Article", func(): get_tree().change_scene_to_file("res://scenes/ArticleTester.tscn")],
			["Test MP ID", func(): get_tree().change_scene_to_file("res://scenes/MultiplayerIdTester.tscn")],
			["Reset Daily", _dev_reset_daily],
			["Official Daily", _dev_official_daily]]:
		var b := _button(entry[0], "TextLink", entry[1])
		b.add_theme_font_size_override("font_size", 12)
		dev.add_child(b)
	box.add_child(dev)
	# Dev: which mode takes the hub's top spot (normally decided by how many
	# people are online - see hub.gd _wants_sp_first).
	var layout_row := HBoxContainer.new()
	layout_row.add_theme_constant_override("separation", 8)
	layout_row.alignment = BoxContainer.ALIGNMENT_CENTER
	layout_row.add_child(_label("Dev: hub top", "SmallMuted"))
	var layout := OptionButton.new()
	layout.focus_mode = Control.FOCUS_NONE
	layout.add_item("Auto (%d+ online = Ranked)" % Global.HUB_SP_FIRST_BELOW, Global.HubLayout.AUTO)
	layout.add_item("Single Player", Global.HubLayout.SINGLE_PLAYER)
	layout.add_item("Ranked", Global.HubLayout.MULTIPLAYER)
	layout.select(layout.get_item_index(Global.hub_layout_override))
	layout.item_selected.connect(func(i: int):
		Global.hub_layout_override = layout.get_item_id(i)
		if scene_file_path == Global.MENU_SCENE:
			get_tree().reload_current_scene())
	layout_row.add_child(layout)
	box.add_child(layout_row)
	# Dev: how the bot in Dummy Ranked / Quick Play plays.
	var bot_row := HBoxContainer.new()
	bot_row.add_theme_constant_override("separation", 8)
	bot_row.alignment = BoxContainer.ALIGNMENT_CENTER
	bot_row.add_child(_label("Dev: bot", "SmallMuted"))
	var bot := OptionButton.new()
	bot.focus_mode = Control.FOCUS_NONE
	bot.add_item("Passive (never guesses)", Global.DummyBotLevel.PASSIVE)
	bot.add_item("Normal", Global.DummyBotLevel.NORMAL)
	bot.add_item("Fast", Global.DummyBotLevel.FAST)
	bot.select(bot.get_item_index(Global.dummy_bot_level))
	bot.item_selected.connect(func(i: int): Global.dummy_bot_level = bot.get_item_id(i))
	bot_row.add_child(bot)
	box.add_child(bot_row)
	_add_modal_close(box)


# Dev: the hub's matchmaking overlay (Ranked or Quick Play), but against
# DummyOpponent with no Steam involved - see Matchmaker._run_dummy.
func _dev_dummy_matchmaking(mode_label: String) -> void:
	Global.pending_dummy_matchmaking = mode_label
	get_tree().change_scene_to_file(HUB_SCENE)


# Dev: fresh local set of 5 for today (no leaderboard - see DailyState.reset_day).
func _dev_reset_daily() -> void:
	var DailyState = load("res://ui/daily/daily_state.gd")
	DailyState.reset_day(DailyState.today_number())
	get_tree().reload_current_scene()


# Dev: wipe today's attempt and go back to the official (online) set.
func _dev_official_daily() -> void:
	var DailyState = load("res://ui/daily/daily_state.gd")
	DailyState.official_day(DailyState.today_number())
	get_tree().reload_current_scene()


func _volume_slider(title: String, value: float, apply: Callable) -> Control:
	var box := VBoxContainer.new()
	box.add_theme_constant_override("separation", 4)
	box.add_child(_label(title, "MutedLabel"))
	var slider := HSlider.new()
	slider.min_value = 0
	slider.max_value = 100
	slider.value = value * 100.0
	slider.focus_mode = Control.FOCUS_NONE
	slider.value_changed.connect(func(v):
		apply.call(v / 100.0)
		_save_settings())
	box.add_child(slider)
	return box


func _on_fullscreen_toggled(on: bool) -> void:
	get_window().mode = Window.MODE_FULLSCREEN if on else Window.MODE_WINDOWED
	settings.fullscreen = on
	_save_settings()


func _save_settings() -> void:
	ResourceSaver.save(settings, SETTINGS_PATH)
